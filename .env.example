DATABASE_URL="file:./dev.db"

# DeepSeek powers text chat and function calling. It takes priority over OpenAI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI text fallback and legacy vision fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Floorplan screenshot recognition uses Qwen3-VL-Plus on Alibaba Cloud Model Studio by default.
# Set VISION_API_KEY; DeepSeek text models do not provide image understanding.
VISION_API_KEY=
# Optional overrides when using a different compatible vision endpoint/model.
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3-vl-plus
