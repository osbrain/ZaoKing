DATABASE_URL="file:./dev.db"

# DeepSeek powers text chat and function calling. It takes priority over OpenAI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI text fallback. Also used for vision unless VISION_* is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional image-capable provider for floorplan screenshot import.
# DeepSeek text models do not provide image understanding.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
